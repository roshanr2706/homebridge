# Backend URL as seen from the phone or browser (use your LAN IP for a physical phone).
# Leave unset for the exported web build served by the backend: it then calls its own origin.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_STUDENT_TOKEN=demo-student
EXPO_PUBLIC_SPONSOR_TOKEN=demo-sponsor
# Sent in the X-Operator header for the reset button, only when the server reports demo mode.
EXPO_PUBLIC_OPERATOR_TOKEN=demo-operator
# PIN hint shown on the sponsor's PIN pad in demo mode only (must match HB_SPONSOR_PIN on the backend).
EXPO_PUBLIC_DEMO_PIN=246810
