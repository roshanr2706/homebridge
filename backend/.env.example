# Copy to backend/.env (gitignored). The backend reads it at startup (uvicorn and Docker); variables already set in the environment win.
# offline (default, no key needed) | deepseek | deepseek-pro | qwen | qwen-cn | custom
# A cloud provider with an empty LLM_API_KEY stops the backend at startup, so keep offline until you have a key.
LLM_PROVIDER=offline
LLM_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_THINKING=0
HB_DEMO_MODE=1
HB_STUDENT_TOKEN=demo-student
HB_SPONSOR_TOKEN=demo-sponsor
# Demo mode pins the sandbox date so screenshots, video and docs agree (empty = real date).
HB_DEMO_TODAY=2026-10-08
# /demo/reset needs this in an X-Operator header, and only works in demo mode. Change it outside a demo.
HB_OPERATOR_TOKEN=demo-operator
# The sponsor's 6-digit approval PIN, stored only as a salted PBKDF2 hash (demo value).
HB_SPONSOR_PIN=246810
# Browser origins allowed to call the API (the exported web app is same-origin and needs none).
HB_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://127.0.0.1:8000,http://localhost:19006
